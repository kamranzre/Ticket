@model LoginViewModel
@{
	ViewData["Title"] = "Login";
}

<div class="container">
	<div class="row justify-content-center mt-5">
		<div class="col-md-5 col-lg-4">

			<div class="card shadow-sm">
				<div class="card-body p-4">

					<h5 class="text-center mb-4">بازیابی رمز عبور</h5>

					<div class="mb-3">
						<label class="form-label">نام کاربری</label>
						<input type="text" id="username" class="form-control" placeholder="نام کاربری">
					</div>

					<div class="d-grid mb-3">
						<button id="btnGetCode" class="btn btn-primary">
							دریافت کد
						</button>
					</div>

					<div id="codeSection" style="display:none">

						<div class="mb-3">
							<label class="form-label">کد تایید</label>
							<input type="text" id="code" class="form-control" placeholder="کد 6 رقمی">
						</div>

						<div class="d-grid mb-3">
							<button id="btnVerifyCode" class="btn btn-success">
								تایید کد
							</button>
						</div>

					</div>

					<div id="passwordSection" style="display:none">

						<div class="mb-3">
							<label class="form-label">رمز جدید</label>
							<input type="password" id="newPassword" class="form-control" placeholder="رمز جدید">
						</div>

						<div class="mb-3">
							<label class="form-label">تکرار رمز جدید</label>
							<input type="password" id="confirmPassword" class="form-control" placeholder="تکرار رمز جدید">
						</div>

						<div class="d-grid">
							<button id="btnResetPassword" class="btn btn-danger">
								تغییر رمز عبور
							</button>
						</div>

					</div>

				</div>
			</div>

		</div>
	</div>
</div>
@section Scripts {
<script src="~/js/forgetPassword.js"></script>
}


