@model LoginViewModel
@{
	ViewData["Title"] = "Login";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5 col-lg-4">

            <div class="card shadow-sm">
                <div class="card-body p-4">

                    <h5 class="text-center mb-4">بازیابی رمز عبور</h5>

                    <div class="mb-3">
                        <label class="form-label">نام کاربری</label>
                        <input type="text" id="username" class="form-control" placeholder="نام کاربری">
                    </div>

                    <div class="d-grid mb-3">
                        <button id="btnGetCode" class="btn btn-primary">
                            دریافت کد
                        </button>
                    </div>

                    <div id="codeSection" style="display:none">

                        <div class="mb-3">
                            <label class="form-label">کد تایید</label>
                            <input type="text" id="code" class="form-control" placeholder="کد 6 رقمی">
                        </div>

                        <div class="d-grid mb-3">
                            <button id="btnVerifyCode" class="btn btn-success">
                                تایید کد
                            </button>
                        </div>

                    </div>

                    <div id="passwordSection" style="display:none">

                        <div class="mb-3">
                            <label class="form-label">رمز جدید</label>
                            <input type="password" id="newPassword" class="form-control" placeholder="رمز جدید">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">تکرار رمز جدید</label>
                            <input type="password" id="confirmPassword" class="form-control" placeholder="تکرار رمز جدید">
                        </div>

                        <div class="d-grid">
                            <button id="btnResetPassword" class="btn btn-danger">
                                تغییر رمز عبور
                            </button>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>



<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>

	$("#btnGetCode").click(function () {

				var username = $("#username").val();
				$.post("/Account/GenerateResetCode", { username: username }, function (res) {

			if (res.success) {
				$("#codeSection").show();
			}
			else {
				alert("کاربر یافت نشد");
			}

		});

	});


		$("#btnVerifyCode").click(function () {

					var username = $("#username").val();
			var code = $("#code").val();

					$.post("/Account/VerifyResetCode", { username: username, code: code }, function (res) {

				if (res.success) {
					$("#passwordSection").show();
				}
				else {
					alert("کد نامعتبر است");
				}

			});

		});

			$("#btnResetPassword").click(function () {

			var username = $("#username").val();
			var password = $("#newPassword").val();
            var code = $("#code").val();

					$.post("/Account/ResetPassword", { username: username, newPassword: password,code:code }, function (res) {

				if (res.success) {
					alert("رمز عبور تغییر کرد");
                     window.location.href = "/Account/Login";
				}
				else {
					alert("خطا");
				}

			});

		});


</script>
